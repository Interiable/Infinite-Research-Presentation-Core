# ============================================================
# LangAIAgent — Environment Variables Template
# 1. cp .env.example .env
# 2. Fill in all values below
# 3. Never commit .env to git
# ============================================================

# ------------------------------------------------------------
# [REQUIRED] Google Gemini API
# Get from: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------
GOOGLE_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------
# [REQUIRED] Tavily Search API (Web Search)
# Get from: https://app.tavily.com/
# ------------------------------------------------------------
TAVILY_API_KEY=your_tavily_api_key_here

# ------------------------------------------------------------
# [OPTIONAL] OpenAI API (fallback LLM)
# Get from: https://platform.openai.com/api-keys
# If not set, Gemini Flash is used as final fallback
# ------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here

# ------------------------------------------------------------
# [OPTIONAL] Google Cloud — Patent BigQuery
# Required only if using patent search feature
# 1. Create GCP project: https://console.cloud.google.com/
# 2. Enable BigQuery API
# 3. Create service account → download JSON key
# ------------------------------------------------------------
GCP_PROJECT_ID=your_gcp_project_id
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service_account.json

# ------------------------------------------------------------
# AI Model Names
# Check latest available models at:
#   Gemini : https://ai.google.dev/gemini-api/docs/models
#   OpenAI : https://platform.openai.com/docs/models
#   Ollama : https://ollama.com/library
# ------------------------------------------------------------

# Primary Gemini model — 계획·비평·최종 검수 (최고 품질)
# Check latest: https://ai.google.dev/gemini-api/docs/models
GEMINI_PRO_MODEL=gemini-3.1-pro-preview

# Backup Gemini Pro — 쿼터 초과 시 자동 전환
GEMINI_PRO_BACKUP_MODEL=gemini-3-pro-preview

# Gemini Flash — 초안 집필·요약·포맷 검사·특허 스코어링 (GA, 최신)
GEMINI_FLASH_MODEL=gemini-3.5-flash

# OpenAI fallback — Gemini 전체 장애 시
OPENAI_MODEL=gpt-5.5

# Gemini Embedding — RAG ChromaDB 벡터 생성
EMBEDDING_MODEL=gemini-embedding-2

# ------------------------------------------------------------
# Local LLM (Ollama) — 역할별 2개 모델 분리 운용
# Install: https://ollama.com/download
#
# 일반 LLM: 번역·합성·필터링·포맷체크 전반
#   ollama pull qwen3.6:27b      (~17GB VRAM, Q4) ← 권장
#
# 과학 LLM: 수학·공학·과학 추론 전용
#   ollama pull gemma4:31b       (~22GB VRAM, Q4) ← 권장
#
# 총 VRAM: 두 모델 동시 로드 시 ~39GB 필요
#          (실제로는 순차 사용이므로 32GB에서도 동작)
# ------------------------------------------------------------
LOCAL_LLM_MODEL=qwen3.6:27b         # 번역·합성·필터링·pre-critique·warden·archivist
LOCAL_SCIENCE_MODEL=gemma4:31b      # 과학/수학/공학 추론 (Researcher 내 Scientific Notes)

# Ollama server URL (default: localhost; change if running on remote GPU server)
OLLAMA_BASE_URL=http://localhost:11434

# ------------------------------------------------------------
# Research Config
# ------------------------------------------------------------
# Absolute path to your local documents folder for RAG ingestion
LOCAL_RESEARCH_DIR=/path/to/your/documents

# PyTorch device: cpu | cuda | mps (Apple Silicon)
TORCH_DEVICE=cpu
