# ============================================================
# LangAIAgent — Environment Variables Template
# 1. cp .env.example .env
# 2. Fill in all values below
# 3. Never commit .env to git
# ============================================================

# ------------------------------------------------------------
# [REQUIRED] Google Gemini API
# Get from: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------
GOOGLE_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------
# [REQUIRED] Tavily Search API (Web Search)
# Get from: https://app.tavily.com/
# ------------------------------------------------------------
TAVILY_API_KEY=your_tavily_api_key_here

# ------------------------------------------------------------
# [OPTIONAL] OpenAI API (fallback LLM)
# Get from: https://platform.openai.com/api-keys
# If not set, Gemini Flash is used as final fallback
# ------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here

# ------------------------------------------------------------
# [OPTIONAL] Google Cloud — Patent BigQuery
# Required only if using patent search feature
# 1. Create GCP project: https://console.cloud.google.com/
# 2. Enable BigQuery API
# 3. Create service account → download JSON key
# ------------------------------------------------------------
GCP_PROJECT_ID=your_gcp_project_id
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service_account.json

# ------------------------------------------------------------
# AI Model Names
# Check latest available models at:
#   Gemini : https://ai.google.dev/gemini-api/docs/models
#   OpenAI : https://platform.openai.com/docs/models
#   Ollama : https://ollama.com/library
# ------------------------------------------------------------

# Primary Gemini model (high-quality reasoning, planning, critique)
GEMINI_PRO_MODEL=gemini-2.5-pro

# Backup Gemini model (same tier, separate quota)
GEMINI_PRO_BACKUP_MODEL=gemini-2.5-pro-preview-06-05

# Fast Gemini model (drafts, summaries, format checks)
GEMINI_FLASH_MODEL=gemini-2.5-flash

# OpenAI fallback model
OPENAI_MODEL=gpt-4o

# Gemini Embedding model for RAG (ChromaDB)
EMBEDDING_MODEL=models/text-embedding-004

# ------------------------------------------------------------
# Local LLM (Ollama)
# Install: https://ollama.com/download
# Pull:    ollama pull qwen3:32b
#
# Recommended options (balance quality vs VRAM):
#   qwen3:32b       — Dense, highest quality   (~20GB VRAM)
#   qwen3:30b-a3b   — MoE, efficient           (~16GB VRAM)
#   deepseek-r1:32b — Best scientific reasoning (~20GB VRAM)
#   gemma3:27b      — Google local model        (~18GB VRAM)
#
# No GPU? Use CPU:  ollama pull qwen3:8b  (smaller, 8GB RAM)
# ------------------------------------------------------------
LOCAL_LLM_MODEL=qwen3:32b

# ------------------------------------------------------------
# Research Config
# ------------------------------------------------------------
# Absolute path to your local documents folder for RAG ingestion
LOCAL_RESEARCH_DIR=/path/to/your/documents

# PyTorch device: cpu | cuda | mps (Apple Silicon)
TORCH_DEVICE=cpu
